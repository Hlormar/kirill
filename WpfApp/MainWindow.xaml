<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Батч обработка фото" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="Выберите папку" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
        <TextBox x:Name="PathTextBox" Grid.Row="1" Grid.Column="0" 
             TextChanged="PathTextBox_TextChanged"/>
        <Button x:Name="BrowseButton" Content="Обзор" Grid.Row="1" Grid.Column="1" 
            Width="80" Click="BrowseButton_Click" Margin="10,0,0,0"/>
        <Label Content="Поддерживаемые форматы: .png, .jpg, .bmp" Grid.Row="2" Grid.Column="0"
               Width="300" HorizontalAlignment="Left"  Foreground="#FF4A4A4A"/>
        <Button x:Name="StartButton" Content="Обработка" Grid.Row="2" Grid.Column="1" 
            Width="Auto" Margin="10,10,0,0" Click="StartButton_Click"/>
        <Label x:Name="StatusLabel" Content="text" BorderThickness="2" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                VerticalAlignment="Bottom" Width="Auto"
                BorderBrush="Transparent">
        </Label>

        <ProgressBar x:Name="StatusBar" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Visible" 
                     Width="Auto" Height="16" VerticalAlignment="Bottom"/>
        <DataGrid x:Name="ResultDataGrid" Grid.Row="3" Grid.Column="0" Visibility="Hidden"
                AutoGenerateColumns="False" 
                IsReadOnly="True"
                CanUserAddRows="False"
                VerticalAlignment="Stretch"
            
                Margin="0,20,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название файла" 
                           Binding="{Binding FileName}" 
                           Width="200"/>
                <DataGridTextColumn Header="Формат" 
                           Binding="{Binding Extension}" 
                           Width="Auto"/>
                <DataGridTextColumn Header="Разрешение" 
                           Binding="{Binding Resolution}" 
                           Width="105"/>
                <DataGridTextColumn Header="Ср. яркость"
                           Binding="{Binding AvgBrightness}" 
                           Width="105"/>
                <DataGridTextColumn Header="Время, мс" 
                           Binding="{Binding Time}" 
                           Width="Auto"/>
                <DataGridTextColumn Header="Статус" 
                           Binding="{Binding Status}" 
                           Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
                  

    </Grid>
</Window>
